{
  "name": "@yuleo/tracelens",
  "version": "0.2.2",
  "private": false,
  "type": "module",
  "description": "Local-first, zero-backend viewer for AI agent traces. Drop in an OpenInference / OTel GenAI trace and see every step, tool call, token and cost — like DevTools for an agent run.",
  "license": "MIT",
  "homepage": "https://yuleo926.github.io/tracelens/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuLeo926/tracelens.git"
  },
  "bugs": {
    "url": "https://github.com/YuLeo926/tracelens/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run typecheck:cli && npm run build:cli",
    "build:web": "npm run typecheck && vite build",
    "build:cli": "tsup",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:cli": "tsc --project tsconfig.cli.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:cli": "npm run build:cli && node cli/smoke.mjs",
    "pack:check": "node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tracelens": "dist-cli/index.js"
  },
  "files": [
    "dist",
    "dist-cli",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0"
  }
}
